+  );
+}
diff --git a/src/lib/estimates/actions.ts b/src/lib/estimates/actions.ts
new file mode 100644
index 0000000..6852c1d
--- /dev/null
+++ b/src/lib/estimates/actions.ts
@@ -0,0 +1,190 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { z } from "zod";
+import { createClient } from "@/lib/supabase/server";
+import { getActionContext, isAdmin } from "@/lib/auth/context";
+import { isValidDayKey } from "@/lib/dates";
+import type { ActionResult } from "@/lib/work/types";
+import { DEFAULT_UNIT, LINE_KINDS, MAX_LINES, parsePercentHundredths, parsePriceCents, parseQuantity } from "./calc";
+import { STATUSES } from "./types";
+
+type IdResult = { ok: true; id: string } | { ok: false; error: string };
+
+const ok = (message?: string): ActionResult => ({ ok: true, message });
+const fail = (error: string): { ok: false; error: string } => ({ ok: false, error });
+const uuid = z.string().uuid();
+
+function mapError(e: { code?: string; message?: string } | null, fallback: string): ActionResult {
+  if (!e) return ok();
+  if (e.code === "P0001" && e.message) return fail(e.message);
+  if (e.code === "23505") return fail("Toks pavadinimas jau yra kataloge.");
+  if (e.code === "42501") return fail("Neturite teisės arba įmonės prieiga sustabdyta.");
+  if (e.code === "23514" || e.code === "22023" || e.code === "22P02" || e.code === "22007") return fail("Patikrinkite įvestus duomenis.");
+  return fail(fallback);
+}
+
+async function adminGuard() {
+  const ctx = await getActionContext();
+  if (!ctx) return fail("Sesija baigėsi. Prisijunkite iš naujo.");
+  if (!ctx.companyId) return fail("Pirmiausia sukurkite įmonę.");
+  if (!isAdmin(ctx.role)) return fail("Sąmatas gali tvarkyti tik administratorius.");
+  return { db: await createClient(), companyId: ctx.companyId };
+}
+const bad = (g: unknown): g is { ok: false; error: string } => typeof g === "object" && g !== null && "ok" in g;
+
+const text = (label: string, max: number) => z.string().trim().max(max, `${label}: per ilgas tekstas.`);
+
+const lineSchema = z.object({
+  kind: z.enum(LINE_KINDS as [string, ...string[]]),
+  name: text("Pavadinimas", 200),
+  unit: text("Vienetas", 20),
+  qty: z.string().max(20),
+  price: z.string().max(20),
+});
+
+const saveSchema = z.object({
+  id: uuid,
+  learn: z.boolean(),
+  title: text("Pavadinimas", 200),
+  projectId: z.union([z.literal(""), uuid]),
+  clientName: text("Klientas", 160),
+  clientPhone: text("Telefonas", 40),
+  clientEmail: z.union([z.literal(""), z.string().trim().email("Neteisingas kliento el. paštas.").max(200)]),
+  address: text("Adresas", 300),
+  status: z.enum(STATUSES as [string, ...string[]]),
+  vat: z.string().max(10),
+  discount: z.string().max(10),
+  validUntil: z.union([z.literal(""), z.string().refine(isValidDayKey, "Neteisinga galiojimo data.")]),
+  notes: text("Pastabos", 4000),
+  lines: z.array(lineSchema).max(MAX_LINES, `Per daug eilučių (daugiausia ${MAX_LINES}).`),
+});
+
+/**
+ * Išsaugo visą sąmatą. Eilutės be pavadinimo, kiekio ir kainos praleidžiamos; tuščias kiekis ar kaina saugoma kaip 0
+ * (juodraštį galima išsaugoti nebaigtą). `learn` = true: nauji pavadinimai ir kainos įrašomi į katalogą.
+ */
+export async function saveEstimate(input: unknown): Promise<ActionResult> {
+  const parsed = saveSchema.safeParse(input);
+  if (!parsed.success) return fail(parsed.error.issues[0].message);
+  const d = parsed.data;
+  const g = await adminGuard();
+  if (bad(g)) return g;
+
+  const vat = d.vat.trim() === "" ? 0 : parsePercentHundredths(d.vat);
+  if (vat === null) return fail("PVM procentas neteisingas (0–100).");
+  const discount = d.discount.trim() === "" ? 0 : parsePercentHundredths(d.discount);
+  if (discount === null) return fail("Nuolaidos procentas neteisingas (0–100).");
+
+  const lines: { pos: number; kind: string; name: string; unit: string; quantity: number; price: number }[] = [];
+  for (const [i, l] of d.lines.entries()) {
+    const label = `${i + 1}. eilutė`;
+    if (!l.name && !l.qty.trim() && !l.price.trim()) continue;
+    if (!l.name) return fail(`${label}: įrašykite pavadinimą.`);
+    const qty = l.qty.trim() === "" ? 0 : parseQuantity(l.qty);
+    if (qty === null) return fail(`${label} (${l.name}): neteisingas kiekis.`);
+    const price = l.price.trim() === "" ? 0 : parsePriceCents(l.price);
+    if (price === null) return fail(`${label} (${l.name}): neteisinga kaina.`);
+    lines.push({
+      pos: lines.length,
+      kind: l.kind,
+      name: l.name,
+      unit: l.unit || DEFAULT_UNIT[l.kind as keyof typeof DEFAULT_UNIT],
+      quantity: qty / 1000,
+      price,
+    });
+  }
+
+  const header = {
+    title: d.title, projectId: d.projectId, clientName: d.clientName, clientPhone: d.clientPhone, clientEmail: d.clientEmail,
+    address: d.address, status: d.status, vatPercent: vat / 100, discountPercent: discount / 100, validUntil: d.validUntil, notes: d.notes,
+  };
+  const { error } = await g.db.rpc("save_estimate", { p_id: d.id, p_header: header, p_lines: lines, p_learn: d.learn });
+  if (error) return mapError(error, "Nepavyko išsaugoti sąmatos.");
+  revalidatePath("/samata");
+  if (d.learn) revalidatePath("/samata/katalogas");
+  return ok("Sąmata išsaugota.");
+}
+
+export async function createEstimate(): Promise<IdResult> {
+  const g = await adminGuard();
+  if (bad(g)) return g;
+  const { data, error } = await g.db.from("estimates").insert({ company_id: g.companyId, title: "" }).select("id").single();
+  if (error || !data) {
+    const m = mapError(error, "Nepavyko sukurti sąmatos.");
+    return m.ok ? fail("Nepavyko sukurti sąmatos.") : fail(m.error);
+  }
+  revalidatePath("/samata");
+  return { ok: true, id: data.id as string };
+}
+
+export async function duplicateEstimate(id: string): Promise<IdResult> {
+  if (!uuid.safeParse(id).success) return fail("Neteisinga sąmata.");
+  const g = await adminGuard();
+  if (bad(g)) return g;
+  const { data, error } = await g.db.rpc("duplicate_estimate", { p_id: id });
+  if (error || !data) {
+    const m = mapError(error, "Nepavyko sukurti kopijos.");
+    return m.ok ? fail("Nepavyko sukurti kopijos.") : fail(m.error);
+  }
+  revalidatePath("/samata");
+  return { ok: true, id: data as string };
+}
+
+export async function deleteEstimate(id: string): Promise<ActionResult> {
+  if (!uuid.safeParse(id).success) return fail("Neteisinga sąmata.");
+  const g = await adminGuard();
+  if (bad(g)) return g;
+  const { data, error } = await g.db.from("estimates").delete().eq("id", id).select("id");
+  if (error) return mapError(error, "Nepavyko ištrinti sąmatos.");
+  if (!data || data.length === 0) return fail("Sąmata nerasta arba prieiga sustabdyta.");
+  revalidatePath("/samata");
+  return ok("Sąmata ištrinta.");
+}
+
+/* ------------------------------------------------------------------ katalogas */
+const catalogSchema = z.object({
+  id: uuid.optional(),
+  kind: z.enum(LINE_KINDS as [string, ...string[]]),
+  name: z.string().trim().min(1, "Įrašykite pavadinimą.").max(200, "Pavadinimas per ilgas."),
+  unit: z.string().trim().min(1, "Įrašykite vienetą (pvz. m, vnt.).").max(20, "Vienetas per ilgas."),
+  price: z.string().max(20),
+});
+
+export async function saveCatalogItem(input: unknown): Promise<ActionResult> {
+  const parsed = catalogSchema.safeParse(input);
+  if (!parsed.success) return fail(parsed.error.issues[0].message);
+  const d = parsed.data;
+  const price = parsePriceCents(d.price);
+  if (price === null) return fail("Įveskite teisingą kainą (pvz. 12,50).");
+  const g = await adminGuard();
+  if (bad(g)) return g;
+
+  if (d.id) {
+    const { data, error } = await g.db
+      .from("estimate_catalog")
+      .update({ kind: d.kind, name: d.name, unit: d.unit, unit_price_cents: price })
+      .eq("id", d.id)
+      .select("id");
+    if (error) return mapError(error, "Nepavyko išsaugoti.");
+    if (!data || data.length === 0) return fail("Įrašas nerastas arba prieiga sustabdyta.");
+  } else {
+    const { error } = await g.db
+      .from("estimate_catalog")
+      .insert({ company_id: g.companyId, kind: d.kind, name: d.name, unit: d.unit, unit_price_cents: price });
+    if (error) return mapError(error, "Nepavyko pridėti.");
+  }
+  revalidatePath("/samata", "layout");
+  return ok("Katalogas atnaujintas.");
+}
+
+export async function deleteCatalogItem(id: string): Promise<ActionResult> {
+  if (!uuid.safeParse(id).success) return fail("Neteisingas įrašas.");
+  const g = await adminGuard();
+  if (bad(g)) return g;
+  const { data, error } = await g.db.from("estimate_catalog").delete().eq("id", id).select("id");
+  if (error) return mapError(error, "Nepavyko ištrinti.");
+  if (!data || data.length === 0) return fail("Įrašas nerastas arba prieiga sustabdyta.");
+  revalidatePath("/samata", "layout");
+  return ok("Ištrinta iš katalogo.");
+}
diff --git a/src/lib/estimates/calc.ts b/src/lib/estimates/calc.ts
new file mode 100644
index 0000000..c07f078
--- /dev/null
+++ b/src/lib/estimates/calc.ts
@@ -0,0 +1,104 @@
+/**
+ * Sąmatos skaičiavimai. Visi pinigai – sveiki centai, kiekiai – tūkstantosios (3 skaitmenys po kablelio),
+ * procentai – šimtosios (21,5 % = 2150), todėl nėra slankiojo kablelio paklaidų.
+ * Ta pati logika yra duomenų bazėje (view estimate_subtotals, migracija 0016): suma = round(kiekis × kaina).
+ */
+import { formatMoney } from "@/lib/money";
+
+export type LineKind = "material" | "work" | "other";
+export const LINE_KINDS: LineKind[] = ["material", "work", "other"];
+export const KIND_LABEL: Record<LineKind, string> = { material: "Medžiagos", work: "Darbai", other: "Kita" };
+export const KIND_ADD_LABEL: Record<LineKind, string> = {
+  material: "Pridėti medžiagą",
+  work: "Pridėti darbą",
+  other: "Pridėti kitą eilutę",
+};
+export const DEFAULT_UNIT: Record<LineKind, string> = { material: "vnt.", work: "val.", other: "vnt." };
+export const UNITS = ["vnt.", "m", "m²", "m³", "kg", "l", "kompl.", "pak.", "rul.", "por.", "val.", "d.", "paslauga"];
+
+export const MAX_LINES = 300;
+export const MAX_QTY_MILLI = 100_000_000; // 100 000
+export const MAX_PRICE_CENTS = 100_000_000; // 1 000 000 €
+
+const clean = (s: string) => s.trim().replace(/\s/g, "").replace(",", ".");
+
+/** „12,5“ -> 12500. Neteisinga (arba tuščia) reikšmė -> null. Iki 3 skaitmenų po kablelio. */
+export function parseQuantity(input: string): number | null {
+  const m = /^(\d{1,6})(?:\.(\d{1,3}))?$/.exec(clean(input));
+  if (!m) return null;
+  const milli = Number(m[1]) * 1000 + Number((m[2] ?? "").padEnd(3, "0"));
+  return milli <= MAX_QTY_MILLI ? milli : null;
+}
+
+/** „12,5“ -> 1250 (centai). Iki 2 skaitmenų po kablelio, ne daugiau 1 000 000 €. */
+export function parsePriceCents(input: string): number | null {
+  const m = /^(\d{1,7})(?:\.(\d{1,2}))?$/.exec(clean(input));
+  if (!m) return null;
+  const cents = Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
+  return cents <= MAX_PRICE_CENTS ? cents : null;
+}
+
+/** „21,5“ -> 2150 (šimtosios procento dalys). 0–100 %. */
+export function parsePercentHundredths(input: string): number | null {
+  const m = /^(\d{1,3})(?:\.(\d{1,2}))?$/.exec(clean(input));
+  if (!m) return null;
+  const h = Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
+  return h <= 10_000 ? h : null;
+}
+
+/** 12500 -> „12,5“, 3000 -> „3“. */
+export function formatQty(milli: number): string {
+  const whole = Math.trunc(milli / 1000);
+  const frac = milli % 1000;
+  return frac === 0 ? String(whole) : `${whole},${String(frac).padStart(3, "0").replace(/0+$/, "")}`;
+}
+
+/** 1250 -> „12,50“ (laukelio reikšmė). */
+export const formatInputCents = (cents: number) => `${Math.trunc(cents / 100)},${String(cents % 100).padStart(2, "0")}`;
+
+/** 2150 -> „21,5“, 2100 -> „21“. */
+export function formatInputPercent(h: number): string {
+  const frac = h % 100;
+  return frac === 0 ? String(Math.trunc(h / 100)) : `${Math.trunc(h / 100)},${String(frac).padStart(2, "0").replace(/0+$/, "")}`;
+}
+
+export const formatEuro = formatMoney;
+
+/** Eilutės suma centais: kiekis × kaina, apvalinama iki cento (pusė – į viršų). */
+export function lineTotalCents(qtyMilli: number, priceCents: number): number {
+  return Number((BigInt(qtyMilli) * BigInt(priceCents) + 500n) / 1000n);
+}
+
+/** Procentas nuo sumos centais (procentas šimtosiomis), apvalinama iki cento. */
+export function percentOfCents(cents: number, hundredths: number): number {
+  return Number((BigInt(cents) * BigInt(hundredths) + 5000n) / 10000n);
+}
+
+export type CalcLine = { kind: LineKind; qtyMilli: number; priceCents: number };
+
+export type Totals = {
+  materials: number;
+  works: number;
+  other: number;
+  subtotal: number;
+  discount: number;
+  /** Suma po nuolaidos, be PVM. */
+  net: number;
+  vat: number;
+  total: number;
+};
+
+/** Iš tarpinės sumos (be nuolaidos) apskaičiuoja nuolaidą, PVM ir galutinę sumą. */
+export function totalsFromSubtotal(subtotal: number, discountHundredths: number, vatHundredths: number) {
+  const discount = percentOfCents(subtotal, discountHundredths);
+  const net = subtotal - discount;
+  const vat = percentOfCents(net, vatHundredths);
+  return { subtotal, discount, net, vat, total: net + vat };
+}
+
+export function calcTotals(lines: CalcLine[], discountHundredths: number, vatHundredths: number): Totals {
+  const by: Record<LineKind, number> = { material: 0, work: 0, other: 0 };
+  for (const l of lines) by[l.kind] += lineTotalCents(l.qtyMilli, l.priceCents);
+  const subtotal = by.material + by.work + by.other;
+  return { materials: by.material, works: by.work, other: by.other, ...totalsFromSubtotal(subtotal, discountHundredths, vatHundredths) };
+}
diff --git a/src/lib/estimates/queries.ts b/src/lib/estimates/queries.ts
new file mode 100644
index 0000000..3d0379c
--- /dev/null
+++ b/src/lib/estimates/queries.ts
@@ -0,0 +1,119 @@
+import { createClient } from "@/lib/supabase/server";
+import type { SessionContext } from "@/lib/auth/context";
+import { totalsFromSubtotal, type LineKind } from "./calc";
+import { isStatus, type CatalogRow, type EstimateFull, type EstimateListRow, type EstimateStatus, type ProjectOption } from "./types";
+
+const toHundredths = (v: number | string) => Math.round(Number(v) * 100);
+
+/** Sąmatų sąrašas su galutine suma (su nuolaida ir PVM). RLS: tik administratorius. */
+export async function getEstimateList(ctx: SessionContext): Promise<{ rows: EstimateListRow[]; error: string | null }> {
+  if (!ctx.company) return { rows: [], error: null };
+  const supabase = await createClient();
+  const { data, error } = await supabase
+    .from("estimates")
+    .select("id, number, title, client_name, status, vat_percent, discount_percent, created_at")
+    .eq("company_id", ctx.company.id)
+    .order("created_at", { ascending: false })
+    .limit(200);
+  if (error) return { rows: [], error: error.message };
+  const list = data ?? [];
+  if (list.length === 0) return { rows: [], error: null };
+
+  const { data: subs, error: subErr } = await supabase
+    .from("estimate_subtotals")
+    .select("estimate_id, subtotal_cents")
+    .in("estimate_id", list.map((e) => e.id));
+  if (subErr) return { rows: [], error: subErr.message };
+  const subtotal = new Map((subs ?? []).map((s) => [s.estimate_id as string, Number(s.subtotal_cents)]));
+
+  const rows = list.map((e) => ({
+    id: e.id as string,
+    number: e.number as string,
+    title: (e.title as string) ?? "",
+    clientName: (e.client_name as string | null) ?? null,
+    status: (isStatus(e.status) ? e.status : "draft") as EstimateStatus,
+    createdAt: e.created_at as string,
+    totalCents: totalsFromSubtotal(subtotal.get(e.id) ?? 0, toHundredths(e.discount_percent), toHundredths(e.vat_percent)).total,
+  }));
+  return { rows, error: null };
+}
+
+export async function getEstimate(ctx: SessionContext, id: string): Promise<EstimateFull | null> {
+  if (!ctx.company) return null;
+  const supabase = await createClient();
+  const { data: e } = await supabase
+    .from("estimates")
+    .select("id, number, title, project_id, client_name, client_phone, client_email, address, status, vat_percent, discount_percent, valid_until, notes")
+    .eq("id", id)
+    .eq("company_id", ctx.company.id)
+    .maybeSingle();
+  if (!e) return null;
+  const { data: lines } = await supabase
+    .from("estimate_lines")
+    .select("id, kind, name, unit, quantity, unit_price_cents")
+    .eq("estimate_id", id)
+    .order("position", { ascending: true })
+    .limit(300);
+  return {
+    id: e.id,
+    number: e.number,
+    title: e.title ?? "",
+    projectId: e.project_id ?? null,
+    clientName: e.client_name ?? "",
+    clientPhone: e.client_phone ?? "",
+    clientEmail: e.client_email ?? "",
+    address: e.address ?? "",
+    status: isStatus(e.status) ? e.status : "draft",
+    vatHundredths: toHundredths(e.vat_percent),
+    discountHundredths: toHundredths(e.discount_percent),
+    validUntil: e.valid_until ?? "",
+    notes: e.notes ?? "",
+    lines: (lines ?? []).map((l) => ({
+      id: l.id as string,
+      kind: l.kind as LineKind,
+      name: l.name as string,
+      unit: l.unit as string,
+      qtyMilli: Math.round(Number(l.quantity) * 1000),
+      priceCents: Number(l.unit_price_cents),
+    })),
+  };
+}
+
+const PAGE = 1000; // Supabase vienu kartu grąžina daugiausia 1000 eilučių
+const MAX_PAGES = 5;
+
+/** Visas įmonės katalogas (naujausi pirma). Skaitomas puslapiais, kad nebūtų tyliai apkarpytas. */
+export async function getCatalog(ctx: SessionContext): Promise<{ rows: CatalogRow[]; truncated: boolean; error: string | null }> {
+  if (!ctx.company) return { rows: [], truncated: false, error: null };
+  const supabase = await createClient();
+  const rows: CatalogRow[] = [];
+  for (let page = 0; page < MAX_PAGES; page++) {
+    const { data, error } = await supabase
+      .from("estimate_catalog")
+      .select("id, kind, name, unit, unit_price_cents, last_used_at")
+      .eq("company_id", ctx.company.id)
+      .order("last_used_at", { ascending: false })
+      .order("id", { ascending: true })
+      .range(page * PAGE, page * PAGE + PAGE - 1);
+    if (error) return { rows, truncated: false, error: error.message };
+    for (const r of data ?? []) {
+      rows.push({ id: r.id, kind: r.kind as LineKind, name: r.name, unit: r.unit, priceCents: Number(r.unit_price_cents), lastUsedAt: r.last_used_at });
+    }
+    if ((data ?? []).length < PAGE) return { rows, truncated: false, error: null };
+  }
+  return { rows, truncated: true, error: null };
+}
+
+export async function getProjectOptions(ctx: SessionContext): Promise<ProjectOption[]> {
+  if (!ctx.company) return [];
+  const supabase = await createClient();
+  const { data } = await supabase
+    .from("projects")
+    .select("id, name, address, client_name, client_phone, client_email")
+    .eq("company_id", ctx.company.id)
+    .order("name", { ascending: true })
+    .limit(500);
+  return (data ?? []).map((p) => ({
+    id: p.id, name: p.name, address: p.address ?? null, clientName: p.client_name ?? null, clientPhone: p.client_phone ?? null, clientEmail: p.client_email ?? null,
+  }));
+}
diff --git a/src/lib/estimates/search.ts b/src/lib/estimates/search.ts
new file mode 100644
index 0000000..d1c18b8
--- /dev/null
+++ b/src/lib/estimates/search.ts
@@ -0,0 +1,54 @@
+import type { LineKind } from "./calc";
+
+/** Vienas katalogo įrašas (medžiaga, darbas ar kita pozicija) su paskutiniu vienetu ir kaina. */
+export type CatalogEntry = { kind: LineKind; name: string; unit: string; priceCents: number; lastUsedAt: string };
+
+/** Mažosios raidės be diakritikų: „Čiaupas“ ir „ciaupas“ sutampa. */
+export const fold = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
+
+/** Toks pat raktas kaip duomenų bazėje (kind + lower(btrim(name))): vienodi pavadinimai laikomi viena pozicija. */
+export const catalogKey = (kind: LineKind, name: string) => `${kind}:${name.trim().toLowerCase()}`;
+
+export type Indexed = CatalogEntry & { folded: string };
+export const indexCatalog = (items: CatalogEntry[]): Indexed[] => items.map((i) => ({ ...i, folded: fold(i.name) }));
+
+const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+
+/** Mažesnis balas = geresnis atitikimas; null = neatitinka. */
+function score(folded: string, q: string, tokens: string[]): number | null {
+  if (folded === q) return 0;
+  if (folded.startsWith(q)) return 1;
+  if (new RegExp(`(^|[\\s\\-/(.,])${escapeRe(q)}`).test(folded)) return 2;
+  if (folded.includes(q)) return 3;
+  if (tokens.length > 1 && tokens.every((t) => folded.includes(t))) return 4;
+  return null;
+}
+
+/**
+ * Siūlomi katalogo įrašai pagal įvestą pradžią ar raides (be diakritikų, žodžio pradžia ar bet kur pavadinime).
+ * Tuščia paieška = neseniai naudoti. Rūšiuojama: geresnis atitikimas, tada naujausiai naudotas.
+ */
+export function searchCatalog(index: Indexed[], kind: LineKind, query: string, limit = 8): CatalogEntry[] {
+  const q = fold(query);
+  const tokens = q.split(/\s+/).filter(Boolean);
+  const hits: { item: Indexed; s: number }[] = [];
+  for (const item of index) {
+    if (item.kind !== kind) continue;
+    const s = q ? score(item.folded, q, tokens) : 0;
+    if (s !== null) hits.push({ item, s });
+  }
+  hits.sort(
+    (a, b) =>
+      a.s - b.s ||
+      b.item.lastUsedAt.localeCompare(a.item.lastUsedAt) ||
+      a.item.name.localeCompare(b.item.name, "lt"),
+  );
+  return hits.slice(0, limit).map((h) => ({ kind: h.item.kind, name: h.item.name, unit: h.item.unit, priceCents: h.item.priceCents, lastUsedAt: h.item.lastUsedAt }));
+}
+
+/** Prideda arba atnaujina įrašus po išsaugojimo, kad naujos pozicijos būtų siūlomos be puslapio perkrovimo. */
+export function mergeCatalog(items: CatalogEntry[], learned: CatalogEntry[]): CatalogEntry[] {
+  const map = new Map(items.map((i) => [catalogKey(i.kind, i.name), i]));
+  for (const l of learned) map.set(catalogKey(l.kind, l.name), l);
+  return [...map.values()];
+}
