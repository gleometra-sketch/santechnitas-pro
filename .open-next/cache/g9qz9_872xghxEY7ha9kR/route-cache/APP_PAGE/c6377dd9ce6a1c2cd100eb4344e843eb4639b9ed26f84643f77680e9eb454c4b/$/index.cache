{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g9qz9_872xghxEY7ha9kR--><html lang=\"lt\" class=\"__variable_65423c __variable_872e30\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/572ba9f284f49768.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-cde5b86c5b7a8429.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-73938ce8a8eac1ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-8b0ab8f5a694b351.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-cafbd01b6d5c4c04.js\" async=\"\"></script><script src=\"/_next/static/chunks/44530001-bad5cebf75b9317a.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/181-064d70ba73390e3f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(app)/layout-e42fe4a78f422791.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0B1B3F\"/><title>DarboRitmas – objektų kalendorius ir darbo laiko apskaita</title><meta name=\"description\" content=\"Planuokite darbus objektuose, leiskite darbuotojams telefonu žymėti laiką ir užsakyti medžiagas. 14 dienų nemokamai, be banko kortelės.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-title\" content=\"DarboRitmas\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"/><link rel=\"icon\" href=\"/icons/icon.svg\" type=\"image/svg+xml\"/><link rel=\"icon\" href=\"/icons/icon-192.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/icons/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-dvh\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"bg-white text-navy\"><header class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-8\"><a aria-label=\"DarboRitmas – pradžia\" href=\"/\"><span class=\"inline-flex items-center gap-3\"><svg width=\"44\" height=\"44\" viewBox=\"0 0 64 64\" class=\"shrink-0\" aria-hidden=\"true\"><path d=\"M16 0h16v64H16A16 16 0 0 1 0 48V16A16 16 0 0 1 16 0z\" fill=\"#1456E8\"></path><path d=\"M32 0h16a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16H32z\" fill=\"#D92D20\"></path><path d=\"M10 34h12l5-14 8 26 6-16 3 4h10\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span class=\"font-display font-bold leading-none \" style=\"font-size:28px;letter-spacing:-0.02em;color:#0B1B3F\">Darbo<span style=\"color:#D92D20\">Ritmas</span></span></span></a><nav aria-label=\"Pagrindinis\" class=\"flex flex-wrap items-center gap-x-7 gap-y-2 font-semibold\"><a href=\"#funkcijos\" class=\"text-accent hover:text-accent-dark\">Funkcijos</a><a href=\"#kainos\" class=\"text-accent hover:text-accent-dark\">Kainos</a><a class=\"text-accent hover:text-accent-dark\" href=\"/prisijungimas\">Prisijungti</a><a class=\"rounded-[10px] bg-navy px-5 py-3 text-white hover:bg-navy-700\" href=\"/registracija\">Išbandyti</a></nav></header><main><section class=\"flex flex-wrap items-stretch\"><div class=\"box-border flex-[1_1_480px] bg-accent px-5 pb-20 pt-16 text-white sm:px-14 sm:pb-24 sm:pt-20\"><p class=\"mb-6 inline-block rounded-lg bg-navy px-3.5 py-2 text-sm font-semibold\">Darbo objektų kalendorius ir laiko apskaita</p><h1 class=\"mb-6 font-display text-[40px] font-bold leading-[1.04] tracking-[-0.025em] sm:text-6xl\">Visi objektai viename kalendoriuje. Kiekviena valanda –<!-- --> <span class=\"rounded-lg bg-navy px-3\">apskaityta.</span></h1><p class=\"mb-9 max-w-[540px] text-lg leading-relaxed sm:text-xl\">Planuokite darbus objektuose, leiskite darbuotojams telefone žymėti laiką ir užsakyti medžiagas. Be Excel lentelių ir skambučių.</p><div class=\"flex flex-wrap gap-4\"><a class=\"rounded-xl bg-white px-7 py-4 text-lg font-semibold text-navy hover:bg-surface\" href=\"/registracija\">Išbandyti DarboRitmą</a><a href=\"#funkcijos\" class=\"rounded-xl border-2 border-white px-7 py-3.5 text-lg font-semibold text-white hover:bg-white/10\">Kaip veikia</a></div></div><div class=\"box-border flex flex-[1_1_420px] items-center bg-brand-red px-5 py-16 sm:px-14 sm:py-20\"><div aria-hidden=\"true\" class=\"w-full rounded-2xl border-[3px] border-navy bg-white p-6 shadow-[10px_10px_0_#0B1B3F]\"><div class=\"mb-4 flex justify-between text-sm font-bold text-muted\"><span>Pr</span><span>An</span><span>Tr</span><span>Kt</span><span>Pn</span></div><div class=\"space-y-3\"><div class=\"\"><div class=\"w-[62%] bg-accent rounded-[10px] px-4 py-3.5 font-semibold text-white\">Objektas 1</div></div><div class=\"ml-[22%]\"><div class=\"w-[56%] bg-brand-red rounded-[10px] px-4 py-3.5 font-semibold text-white\">Objektas 2</div></div><div class=\"ml-[40%]\"><div class=\"w-[60%] bg-navy rounded-[10px] px-4 py-3.5 font-semibold text-white\">Objektas 3</div></div><div class=\"\"><div class=\"w-[38%] bg-accent rounded-[10px] px-4 py-3.5 font-semibold text-white\">Objektas 4</div></div></div></div></div></section><section id=\"funkcijos\" class=\"mx-auto max-w-[1200px] scroll-mt-4 px-5 py-20 sm:px-8 sm:py-24\"><h2 class=\"font-display text-4xl font-bold tracking-tight sm:text-[44px]\">Viskas, ko reikia objektų darbams</h2><p class=\"mb-12 mt-3 max-w-2xl text-lg text-muted\">Funkcijos, kurios pakeičia popierius, Excel lenteles ir skambučius tarp biuro ir objekto.</p><ul class=\"grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6\"><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-accent\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Objektai ir darbai</h3><p class=\"leading-relaxed text-muted\">Biuras sukuria objektus ir darbus su užduočių sąrašu, paskiria darbuotoją ir datą. Darbuotojas telefone mato adresą su nuoroda į žemėlapį, užsakymo numerį ir atliktų punktų eigą.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-brand-red\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Kalendorius</h3><p class=\"leading-relaxed text-muted\">Mėnesio ir savaitės vaizdas rodo, kiek darbų kiekvieną dieną. Darbą galima perkelti į kitą dieną, o darbai be datos laukia atskirame sąraše.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-accent\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Darbo laikas telefone</h3><p class=\"leading-relaxed text-muted\">Pradėti, pertrauka, tęsti, baigti. Laiką fiksuoja serveris, todėl dvigubas paspaudimas nieko nesugadina, o tas pats laikmatis matomas ir telefone, ir kompiuteryje. Nedirbama diena pažymima vienu paspaudimu.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-brand-red\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Valandos ir atlyginimas</h3><p class=\"leading-relaxed text-muted\">Šiandien, savaitė ir mėnuo be pertraukų, mėnesių istorija ir atlyginimo skaičiuoklė pagal valandinį įkainį. Įkainis lieka tik darbuotojo įrenginyje.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-accent\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Medžiagų užsakymai</h3><p class=\"leading-relaxed text-muted\">Darbuotojas vienu prašymu surašo kelias medžiagas su kiekiu, vienetu ir objektu. Biuras mato bendrą sąrašą, filtruoja, taiso kiekius ir žymi „Nupirkta“, o istorija išlieka.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-brand-red\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Pastaba biurui</h3><p class=\"leading-relaxed text-muted\">Darbuotojas parašo arba padiktuoja pastabą tiesiai prie darbo, o biuras nebeskambina ir nebeieško žinučių.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-accent\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Valdymas biure</h3><p class=\"leading-relaxed text-muted\">Administratorius tvarko objektus, kviečia darbuotojus, keičia vaidmenis ir pataiso darbo laiko įrašus, jei kas nors pamiršo paspausti „Baigti“.</p></li><li class=\"rounded-2xl border-2 border-navy p-7\"><span aria-hidden=\"true\" class=\"mb-5 block h-3 w-3 rounded-full bg-brand-red\"></span><h3 class=\"mb-2.5 font-display text-2xl font-bold\">Kiekvienos įmonės duomenys atskirti</h3><p class=\"leading-relaxed text-muted\">Įmonė mato tik savo objektus, darbus ir valandas. Duomenys saugomi serveryje, o ne tik telefono atmintyje.</p></li></ul></section><section id=\"kainos\" class=\"scroll-mt-4 bg-surface\"><div class=\"mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24\"><h2 class=\"font-display text-4xl font-bold tracking-tight sm:text-[44px]\">Abonementai</h2><p class=\"mb-12 mt-3 max-w-2xl text-lg text-muted\">14 dienų išbandykite nemokamai, be banko kortelės. Mokėkite kas mėnesį ir planą keiskite bet kada.</p><div class=\"grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-stretch gap-6\"><div class=\"flex flex-col rounded-2xl border-2 border-navy p-8 bg-white\"><h3 class=\"mb-2 font-display text-[26px] font-bold\">Bazinis</h3><div class=\"mb-6 font-display text-[40px] font-bold leading-tight\"><span class=\"text-3xl\">Kaina netrukus</span></div><ul class=\"mb-7 flex-1 space-y-2.5\"><li>Objektai, darbai ir kalendorius</li><li>Darbo laiko apskaita telefone</li><li>Medžiagų užsakymai ir pirkimų sąrašas</li></ul><a class=\"block rounded-[10px] px-4 py-3.5 text-center font-semibold border-2 border-accent text-accent hover:bg-accent-soft\" href=\"/registracija\">Pasirinkti</a></div><div class=\"flex flex-col rounded-2xl border-2 border-navy p-8 bg-navy text-white shadow-[10px_10px_0_#D92D20]\"><h3 class=\"mb-2 font-display text-[26px] font-bold\">Pro</h3><div class=\"mb-6 font-display text-[40px] font-bold leading-tight\"><span class=\"text-3xl\">Kaina netrukus</span></div><ul class=\"mb-7 flex-1 space-y-2.5\"><li>Objektai, darbai ir kalendorius</li><li>Darbo laiko apskaita telefone</li><li>Medžiagų užsakymai ir pirkimų sąrašas</li></ul><a class=\"block rounded-[10px] px-4 py-3.5 text-center font-semibold bg-brand-red text-white hover:bg-[#b8241a]\" href=\"/registracija\">Pasirinkti</a></div><div class=\"flex flex-col rounded-2xl border-2 border-navy p-8 bg-white\"><h3 class=\"mb-2 font-display text-[26px] font-bold\">Verslui</h3><div class=\"mb-6 font-display text-[40px] font-bold leading-tight\"><span class=\"text-3xl\">Kaina netrukus</span></div><ul class=\"mb-7 flex-1 space-y-2.5\"><li>Objektai, darbai ir kalendorius</li><li>Darbo laiko apskaita telefone</li><li>Medžiagų užsakymai ir pirkimų sąrašas</li></ul><a class=\"block rounded-[10px] px-4 py-3.5 text-center font-semibold border-2 border-accent text-accent hover:bg-accent-soft\" href=\"/registracija\">Pasirinkti</a></div></div></div></section><section class=\"flex flex-wrap text-white\"><div class=\"box-border flex flex-[1_1_480px] items-center bg-accent px-5 py-16 sm:px-14 sm:py-[72px]\"><h2 class=\"max-w-[640px] font-display text-4xl font-bold leading-[1.08] tracking-tight sm:text-[44px]\">Sudėliokite komandos darbus į vieną ritmą.</h2></div><div class=\"box-border flex flex-[1_1_360px] items-center bg-brand-red px-5 py-14 sm:px-14 sm:py-[72px]\"><a class=\"rounded-xl bg-white px-8 py-[18px] text-lg font-semibold text-navy hover:bg-surface\" href=\"/registracija\">Išbandyti DarboRitmą</a></div></section></main><footer class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-5 py-8 text-sm text-muted sm:px-8\"><span class=\"inline-flex items-center gap-3\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 64 64\" class=\"shrink-0\" aria-hidden=\"true\"><path d=\"M16 0h16v64H16A16 16 0 0 1 0 48V16A16 16 0 0 1 16 0z\" fill=\"#1456E8\"></path><path d=\"M32 0h16a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16H32z\" fill=\"#D92D20\"></path><path d=\"M10 34h12l5-14 8 26 6-16 3 4h10\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg><span class=\"font-display font-bold leading-none \" style=\"font-size:18px;letter-spacing:-0.02em;color:#0B1B3F\">Darbo<span style=\"color:#D92D20\">Ritmas</span></span></span><span class=\"flex flex-wrap gap-x-5 gap-y-1\"><a class=\"hover:underline\" href=\"/privatumas\">Privatumo politika</a><a class=\"hover:underline\" href=\"/prisijungimas\">Prisijungti</a><span>© DarboRitmas</span></span></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-cde5b86c5b7a8429.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[4284,[\\\"177\\\",\\\"static/chunks/app/layout-cafbd01b6d5c4c04.js\\\"],\\\"default\\\"]\\n5:I[2619,[\\\"730\\\",\\\"static/chunks/44530001-bad5cebf75b9317a.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"181\\\",\\\"static/chunks/181-064d70ba73390e3f.js\\\",\\\"944\\\",\\\"static/chunks/app/(app)/layout-e42fe