{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/privatumas/layout,_N_T_/privatumas/page,_N_T_/privatumas"},"routeCache":{"key":"/route-cache/APP_PAGE/66068dbf9ef198d1d119608a192917897fddf83712eee1eae78b1254da60b8b0/$/privatumas","owner":{"kind":"APP_PAGE","sourceRoute":"/privatumas/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g9qz9_872xghxEY7ha9kR--><html lang=\"lt\" class=\"__variable_65423c __variable_872e30\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/572ba9f284f49768.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-cde5b86c5b7a8429.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-73938ce8a8eac1ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-8b0ab8f5a694b351.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-cafbd01b6d5c4c04.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/privatumas/page-106b6b48621c6806.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0B1B3F\"/><title>Privatumo politika · DarboRitmas</title><meta name=\"description\" content=\"Darbo objektų kalendorius, darbo laiko apskaita ir medžiagų užsakymai komandoms, dirbančioms objektuose.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-title\" content=\"DarboRitmas\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"/><link rel=\"icon\" href=\"/icons/icon.svg\" type=\"image/svg+xml\"/><link rel=\"icon\" href=\"/icons/icon-192.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/icons/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-dvh\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"mx-auto max-w-2xl space-y-4 px-4 py-8\"><p class=\"rounded-2xl bg-accent-soft p-3 text-sm\">Šablonas. Prieš paleidžiant programą klientams įrašykite duomenų valdytojo rekvizitus ir peržiūrėkite tekstą su teisininku.</p><h1 class=\"text-3xl font-extrabold\">Privatumo politika</h1><h2 class=\"text-xl font-bold\">Kokius duomenis saugome</h2><p>Vardą, el. paštą, įmonės pavadinimą, darbo laiko įrašus, pertraukas, objektų adresus, pastabas, jūsų įkeltus failus (nuotraukas, balso įrašus) ir mokėjimų istoriją.</p><h2 class=\"text-xl font-bold\">Kam jų reikia</h2><p>Paslaugai teikti: darbo laiko apskaitai, darbų planavimui, medžiagų užsakymams ir prenumeratos valdymui.</p><h2 class=\"text-xl font-bold\">Kas apdoroja duomenis</h2><p>Duomenys saugomi Supabase (duomenų bazė ir failai), mokėjimus apdoroja Stripe. Banko kortelės duomenų mes nematome ir nesaugome.</p><h2 class=\"text-xl font-bold\">Jūsų teisės</h2><p>Galite prašyti peržiūrėti, ištaisyti, eksportuoti ar ištrinti savo duomenis. Duomenų valdytojo kontaktai: [įrašykite].</p><p><a class=\"font-semibold text-accent-dark underline\" href=\"/registracija\">Grįžti</a></p></main><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-cde5b86c5b7a8429.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[4284,[\\\"177\\\",\\\"static/chunks/app/layout-cafbd01b6d5c4c04.js\\\"],\\\"default\\\"]\\n5:I[2619,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"853\\\",\\\"static/chunks/app/privatumas/page-106b6b48621c6806.js\\\"],\\\"\\\"]\\n6:I[4431,[],\\\"OutletBoundary\\\"]\\n8:I[5278,[],\\\"AsyncMetada