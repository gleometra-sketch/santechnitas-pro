# Nukopijuokite į .env.local ir užpildykite. NIEKADA nekelkite tikrų raktų į Git.

# Programos adresas (vietoje: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (bus naudojama nuo 3 etapo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tik serveriui. Niekada nenaudoti naršyklėje.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paddle (mokėjimai ir planai). Žr. docs/PADDLE.md ---
# sandbox (bandymams) arba production (tikri pinigai)
PADDLE_ENV=sandbox
# Paddle > Developer tools > Authentication > API keys. SLAPTAS, tik serveriui.
PADDLE_API_KEY=
# Paddle > Developer tools > Notifications > jūsų endpoint > Secret key. SLAPTAS.
PADDLE_WEBHOOK_SECRET=
# Client-side token (test_... arba live_...). Viešas, ne paslaptis.
PADDLE_CLIENT_TOKEN=
# Paddle kainų ID (pri_...): trys planai × mėnesinė / metinė, kaina už vieną darbuotoją (kiekis nuo 3)
PADDLE_PRICE_BAZINIS_MONTHLY=
PADDLE_PRICE_BAZINIS_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_VERSLUI_MONTHLY=
PADDLE_PRICE_VERSLUI_YEARLY=

# --- Telegram botas (pranešimai administratoriams) ---
# Token iš @BotFather. Slaptas, tik serveriui.
TELEGRAM_BOT_TOKEN=
# Boto vartotojo vardas be @ (pvz. DarboRitmasBot). Naudojamas prijungimo nuorodai.
TELEGRAM_BOT_USERNAME=
# Bet kokia ilga atsitiktinė eilutė (A-Z a-z 0-9 _ -), tą pačią nurodysite setWebhook. Žr. docs/TELEGRAM.md
TELEGRAM_WEBHOOK_SECRET=

# --- Pranešimų eilė ir automobilių priminimai ---
# Ilga atsitiktinė eilutė. Naudoja Supabase webhook (/api/notifications/dispatch) ir GitHub cron (/api/cars/reminders):
# antraštė "Authorization: Bearer <CRON_SECRET>". Žr. docs/PRANESIMAI.md
CRON_SECRET=

# --- Pardavėjo rekvizitai juridiniams puslapiams (/salygos, /grazinimai, /privatumas). Žr. docs/JURIDINIAI.md ---
# Tikslus teisinis pavadinimas (Paddle jo reikalauja sąlygose ir privatumo pranešime), kodas, adresas, el. paštas
LEGAL_NAME=
LEGAL_CODE=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_VAT=
