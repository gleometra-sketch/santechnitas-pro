# Nukopijuokite į .env.local ir užpildykite. NIEKADA nekelkite tikrų raktų į Git.

# Programos adresas (vietoje: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (bus naudojama nuo 3 etapo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tik serveriui. Niekada nenaudoti naršyklėje.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (bus naudojama nuo 7 etapo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Telegram botas (pranešimai administratoriams) ---
# Token iš @BotFather. Slaptas, tik serveriui.
TELEGRAM_BOT_TOKEN=
# Boto vartotojo vardas be @ (pvz. DarboRitmasBot). Naudojamas prijungimo nuorodai.
TELEGRAM_BOT_USERNAME=
# Bet kokia ilga atsitiktinė eilutė (A-Z a-z 0-9 _ -), tą pačią nurodysite setWebhook. Žr. docs/TELEGRAM.md
TELEGRAM_WEBHOOK_SECRET=
